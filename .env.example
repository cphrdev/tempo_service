# Dedicated secp256k1 Tempo service wallet. It receives tickets and sends prizes.
PAYMENT_DESTINATION=0xYourTempoAddress

# Generate with: openssl rand -hex 32
MPP_SECRET_KEY=replace-with-a-long-random-secret

# Private key for PAYMENT_DESTINATION. Keep only in the VPS secret environment.
# A passkey-only wallet cannot be used for unattended automatic payouts.
LOTTERY_PAYOUT_PRIVATE_KEY=0xNeverCommitThisValue

TEMPO_RPC_URL=https://rpc.tempo.xyz
MPP_REALM=localhost:8000

LOTTERY_DATABASE_PATH=data/lottery.db
LOTTERY_LOG_PATH=logs/lottery.log
# Keep false until legal review and an end-to-end payout test are complete.
LOTTERY_ENABLED=false
# Monday=0 ... Sunday=6. Default: Sunday at 20:00 UTC.
DRAW_WEEKDAY_UTC=6
DRAW_HOUR_UTC=20
DRAW_MINUTE_UTC=0
DRAW_SECOND_UTC=0
PAYOUT_BPS=9000
